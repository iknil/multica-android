index 7cdf0667e..7d147abdf 100644
--- a/apps/docs/content/docs/auth-tokens.zh.mdx
+++ b/apps/docs/content/docs/auth-tokens.zh.mdx
@@ -15,6 +15,10 @@ import { Callout } from "fumadocs-ui/components/callout";
 
 浏览器 cookie 不适合复制到脚本或 CLI；从终端访问 Multica 使用个人访问令牌。
 
+## Android 浏览器登录回流
+
+Android 打开浏览器，通过邮箱或 Google 登录后，用一次性授权码返回应用。授权码最多有效五分钟，并绑定应用发起的 state 和 PKCE S256 challenge。应用在 WebView 中兑换新的 HttpOnly 会话和可读的 CSRF cookie；跳转链接和 JavaScript 都不会收到 bearer token。浏览器和 WebView 的会话互相独立。验证 HTTPS App Links 时，需要在 Web 服务的 `ANDROID_RELEASE_CERT_SHA256` 中配置正式签名证书的公开指纹，无需提供私有签名密钥。
+
 ## 个人访问令牌
 
 个人访问令牌（PAT）以 `mul_` 开头，代表你的账号。它可以访问你有权访问的全部工作区和 API，需要像密码一样保管。
