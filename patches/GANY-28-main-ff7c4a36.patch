diff --git a/server/internal/handler/auth_android_login_test.go b/server/internal/handler/auth_android_login_test.go
new file mode 100644
index 000000000..b11fa871e
--- /dev/null
+++ b/server/internal/handler/auth_android_login_test.go
@@ -0,0 +1,60 @@
+package handler
+
+import (
+	"fmt"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/multica-ai/multica/server/internal/testutil"
+)
+
+func TestAndroidCookieOnlyLoginAndHandoff(t *testing.T) {
+	for _, method := range []string{"email", "google"} {
+		t.Run(method, func(t *testing.T) {
+			email := fmt.Sprintf("android-%s-%d@example.com", method, time.Now().UnixNano())
+			userID := dbfx.User(t, "Android Cookie Login", email)
+			h := newTestHandler(Config{AllowSignup: true})
+			h.Queries = testHandler.Queries
+			var response *testutil.Response
+			if method == "email" {
+				dbfx.Insert(t, "verification_code", testutil.Cols{
+					"email": email, "code": "124689", "expires_at": time.Now().Add(time.Minute),
+				})
+				response = testutil.Call(t, h.VerifyCode, testutil.JSONRequest(http.MethodPost, "/auth/verify-code", map[string]any{
+					"email": email, "code": "124689", "cookie_only": true,
+				})).Want(http.StatusOK)
+			} else {
+				t.Setenv("GOOGLE_CLIENT_ID", "test-client")
+				t.Setenv("GOOGLE_CLIENT_SECRET", "test-secret")
+				h.googleOAuthHTTPClient = &http.Client{Transport: googleRoundTripper(func(req *http.Request) (*http.Response, error) {
+					switch req.URL.Host {
+					case "oauth2.googleapis.com":
+						return googleResponse(req, http.StatusOK, `{"access_token":"test-token"}`), nil
+					case "www.googleapis.com":
+						return googleResponse(req, http.StatusOK, fmt.Sprintf(`{"email":%q}`, email)), nil
+					default:
+						t.Fatalf("unexpected provider request: %s", req.URL.Host)
+						return nil, nil
+					}
+				})}
+				response = testutil.Call(t, h.GoogleLogin, testutil.JSONRequest(http.MethodPost, "/auth/google", map[string]any{
+					"code": "test-code", "redirect_uri": "https://multica.ai/auth/callback", "cookie_only": true,
+				})).Want(http.StatusOK)
+			}
+			out := response.Map()
+			if _, ok := out["token"]; ok {
+				t.Fatal("cookie-only browser login must not return a bearer token to JavaScript")
+			}
+			if response.Header().Get("Cache-Control") != "no-store" {
+				t.Fatal("login response must not be cached")
+			}
+			user, ok := out["user"].(map[string]any)
+			if !ok || user["id"] != userID {
+				t.Fatal("login returned the wrong user")
+			}
+			code := androidPrepareCode(t, h, response.Result().Cookies())
+			testutil.Call(t, h.ExchangeAndroidAuth, androidExchangeRequest(code)).Want(http.StatusSeeOther)
+		})
+	}
+}
