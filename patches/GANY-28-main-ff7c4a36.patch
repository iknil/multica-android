+"use client";
+
+import {
+  Card,
+  CardContent,
+  CardDescription,
+  CardHeader,
+  CardTitle,
+} from "@multica/ui/components/ui/card";
+import { Button } from "@multica/ui/components/ui/button";
+import { Loader2 } from "@multica/ui/icons";
+import { useT } from "@multica/views/i18n";
+
+export function AndroidHandoffCard({
+  redirectUrl,
+  errorDescription,
+}: {
+  redirectUrl?: string | null;
+  errorDescription?: string | null;
+}) {
+  const { t } = useT("auth");
+
+  if (errorDescription) {
+    return (
+      <div className="flex min-h-screen items-center justify-center">
+        <Card className="w-full max-w-sm">
+          <CardHeader className="text-center">
+            <CardTitle className="text-display-sm">
+              {t(($) => $.web.callback.failed_title)}
+            </CardTitle>
+            <CardDescription>{errorDescription}</CardDescription>
+          </CardHeader>
+        </Card>
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex min-h-screen items-center justify-center">
+      <Card className="w-full max-w-sm">
+        <CardHeader className="text-center">
+          <CardTitle className="text-display-sm">
+            {t(($) => $.web.android_handoff.opening_title)}
+          </CardTitle>
+          <CardDescription>
+            {redirectUrl
+              ? t(($) => $.web.android_handoff.opening_description)
+              : t(($) => $.web.android_handoff.preparing)}
+          </CardDescription>
+        </CardHeader>
+        <CardContent className="flex justify-center">
+          {redirectUrl ? (
+            <Button
+              variant="outline"
+              onClick={() => {
+                window.location.href = redirectUrl;
+              }}
+            >
+              {t(($) => $.web.android_handoff.open_button)}
+            </Button>
+          ) : (
+            <Loader2 className="h-6 w-6 animate-spin text-muted-foreground" />
+          )}
+        </CardContent>
+      </Card>
+    </div>
+  );
+}
