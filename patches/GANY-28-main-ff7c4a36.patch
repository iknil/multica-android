+"use client";
+
+import { Suspense, useEffect } from "react";
+import { useSearchParams } from "next/navigation";
+import { AndroidHandoffCard } from "@/features/auth/android-handoff-card";
+import { androidCallbackUrlFromSearchParams } from "@/features/auth/android-auth";
+import { useT } from "@multica/views/i18n";
+
+function AndroidCallbackContent() {
+  const { t } = useT("auth");
+  const searchParams = useSearchParams();
+  const redirectUrl = androidCallbackUrlFromSearchParams(searchParams);
+
+  useEffect(() => {
+    if (redirectUrl) window.location.href = redirectUrl;
+  }, [redirectUrl]);
+
+  return (
+    <AndroidHandoffCard
+      redirectUrl={redirectUrl}
+      errorDescription={
+        redirectUrl
+          ? null
+          : t(($) => $.web.android_handoff.invalid_request)
+      }
+    />
+  );
+}
+
+export default function AndroidCallbackPage() {
+  return (
+    <Suspense fallback={null}>
+      <AndroidCallbackContent />
+    </Suspense>
+  );
+}
