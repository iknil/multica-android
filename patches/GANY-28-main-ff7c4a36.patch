diff --git a/server/internal/handler/android_auth.go b/server/internal/handler/android_auth.go
new file mode 100644
index 000000000..281ebd085
--- /dev/null
+++ b/server/internal/handler/android_auth.go
@@ -0,0 +1,217 @@
+package handler
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"mime"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/golang-jwt/jwt/v5"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgtype"
+	"github.com/multica-ai/multica/server/internal/auth"
+	db "github.com/multica-ai/multica/server/pkg/db/generated"
+)
+
+const androidAppID = "ai.multica.android"
+
+func androidAuthHeaders(w http.ResponseWriter) {
+	w.Header().Set("Cache-Control", "no-store")
+	w.Header().Set("Referrer-Policy", "no-referrer")
+	w.Header().Set("Pragma", "no-cache")
+}
+
+func validAndroidBase64URL(value string, minBytes, maxBytes int) bool {
+	decoded, err := base64.RawURLEncoding.Strict().DecodeString(value)
+	return err == nil && len(decoded) >= minBytes && len(decoded) <= maxBytes &&
+		base64.RawURLEncoding.EncodeToString(decoded) == value
+}
+
+func validAndroidVerifier(value string) bool {
+	if len(value) < 43 || len(value) > 128 {
+		return false
+	}
+	for _, c := range value {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || strings.ContainsRune("-._~", c)) {
+			return false
+		}
+	}
+	return true
+}
+
+// PrepareAndroidAuth accepts only a signed human browser cookie and its CSRF
+// proof. Header credentials must never become an app login authorization.
+func (h *Handler) PrepareAndroidAuth(w http.ResponseWriter, r *http.Request) {
+	androidAuthHeaders(w)
+	cookie, err := r.Cookie(auth.AuthCookieName)
+	if err != nil || cookie.Value == "" || r.Header.Get("Authorization") != "" {
+		writeError(w, http.StatusUnauthorized, "browser cookie session required")
+		return
+	}
+	claims := jwt.MapClaims{}
+	token, err := jwt.ParseWithClaims(cookie.Value, claims, func(token *jwt.Token) (any, error) {
+		return auth.JWTSecret(), nil
+	}, jwt.WithValidMethods([]string{"HS256"}), jwt.WithExpirationRequired())
+	if err != nil || !token.Valid {
+		writeError(w, http.StatusUnauthorized, "invalid browser session")
+		return
+	}
+	userID, _ := claims.GetSubject()
+	var id pgtype.UUID
+	if err := id.Scan(userID); err != nil || !id.Valid {
+		writeError(w, http.StatusUnauthorized, "invalid browser session")
+		return
+	}
+	sid, _ := claims["sid"].(string)
+	exp, err := claims.GetExpirationTime()
+	if err != nil || exp == nil || sid == "" {
+		writeError(w, http.StatusUnauthorized, "sign in again before opening Android")
+		return
+	}
+	if !auth.ValidateCSRF(r) {
+		writeError(w, http.StatusForbidden, "CSRF validation failed")
+		return
+	}
+	user, err := h.Queries.GetUser(r.Context(), id)
+	if errors.Is(err, pgx.ErrNoRows) {
+		writeError(w, http.StatusUnauthorized, "browser user not found")
+		return
+	}
+	if err != nil {
+		writeError(w, http.StatusInternalServerError, "failed to load browser user")
+		return
+	}
+	if auth.IsTemporarilyDisabledUser(userID, user.Email) {
+		writeError(w, http.StatusForbidden, auth.TemporarilyDisabledUserError)
+		return
+	}
+
+	var req struct {
+		State         string `json:"state"`
+		CodeChallenge string `json:"code_challenge"`
+		AppID         string `json:"app_id"`
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, 4096)
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil ||
+		!validAndroidBase64URL(req.State, 16, 96) || !validAndroidBase64URL(req.CodeChallenge, 32, 32) || req.AppID != androidAppID {
+		writeError(w, http.StatusBadRequest, "invalid Android handoff")
+		return
+	}
+
+	callbackBase := "multica-android://auth/callback"
+	if strings.EqualFold(os.Getenv("ANDROID_AUTH_USE_APP_LINKS"), "true") {
+		origin, err := url.Parse(strings.TrimRight(os.Getenv("FRONTEND_ORIGIN"), "/"))
+		if err != nil || origin.Scheme != "https" || origin.Host == "" || origin.User != nil || origin.Path != "" || origin.RawQuery != "" || origin.ForceQuery || origin.Fragment != "" {
+			writeError(w, http.StatusServiceUnavailable, "verified HTTPS Android callback is not configured")
+			return
+		}
+		callbackBase = origin.String() + "/auth/android/callback"
+	}
+	codeBytes := make([]byte, 32)
+	if _, err := rand.Read(codeBytes); err != nil {
+		writeError(w, http.StatusInternalServerError, "failed to prepare Android handoff")
+		return
+	}
+	code := base64.RawURLEncoding.EncodeToString(codeBytes)
+	if err := h.Queries.DeleteExpiredAndroidAuthCodes(r.Context()); err != nil {
+		writeError(w, http.StatusInternalServerError, "failed to prepare Android handoff")
+		return
+	}
+	if err := h.Queries.CreateAndroidAuthCode(r.Context(), db.CreateAndroidAuthCodeParams{
+		CodeHash: auth.HashToken(code), UserID: id, SessionID: sid,
+		SessionExpiresAt: pgtype.Timestamptz{Time: exp.Time, Valid: true},
+		State:            req.State, CodeChallenge: req.CodeChallenge, AppID: androidAppID,
+	}); err != nil {
+		writeError(w, http.StatusInternalServerError, "failed to prepare Android handoff")
+		return
+	}
+	callback := callbackBase + "?" + url.Values{"code": {code}, "state": {req.State}}.Encode()
+	writeJSON(w, http.StatusOK, map[string]string{"redirect_url": callback})
+}
+
+// ExchangeAndroidAuth is intentionally outside browser authentication: Android
+// posts the proof into a WebView that has no cookies yet.
+func (h *Handler) ExchangeAndroidAuth(w http.ResponseWriter, r *http.Request) {
+	androidAuthHeaders(w)
+	// Native WebView.postUrl can omit Origin. Browser form submissions must
+	// come from our origin so an attacker cannot plant their session in a browser.
+	origin := r.Header.Get("Origin")
+	if r.Header.Get("Sec-Fetch-Site") == "cross-site" || (origin != "" && origin != strings.TrimRight(os.Getenv("FRONTEND_ORIGIN"), "/")) {
+		writeError(w, http.StatusForbidden, "same-origin Android exchange required")
+		return
+	}
+	// Native postUrl requests can omit Content-Type; the exchange body is a form.
+	if r.Header.Get("Content-Type") == "" {
+		r.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	}
+	mediaType, _, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+	if err != nil || mediaType != "application/x-www-form-urlencoded" {
+		writeError(w, http.StatusUnsupportedMediaType, "form body required")
+		return
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, 4096)
+	if err := r.ParseForm(); err != nil {
+		writeError(w, http.StatusBadRequest, "invalid Android exchange")
+		return
+	}
+	// URL query parameters must not supply credentials or override the POST body.
+	code, state, verifier := r.PostForm.Get("code"), r.PostForm.Get("state"), r.PostForm.Get("code_verifier")
+	appID := r.PostForm.Get("app_id")
+	if appID == "" {
+		appID = androidAppID
+	}
+	if len(r.PostForm["code"]) != 1 || len(r.PostForm["state"]) != 1 || len(r.PostForm["code_verifier"]) != 1 ||
+		!validAndroidBase64URL(code, 32, 32) || !validAndroidBase64URL(state, 16, 96) || !validAndroidVerifier(verifier) || appID != androidAppID {
+		writeError(w, http.StatusBadRequest, "invalid Android exchange")
+		return
+	}
+	challenge := sha256.Sum256([]byte(verifier))
+	id, err := h.Queries.ConsumeAndroidAuthCode(r.Context(), db.ConsumeAndroidAuthCodeParams{
+		CodeHash: auth.HashToken(code), State: state,
+		CodeChallenge: base64.RawURLEncoding.EncodeToString(challenge[:]), AppID: androidAppID,
+	})
+	if errors.Is(err, pgx.ErrNoRows) {
+		writeError(w, http.StatusBadRequest, "invalid or expired Android code")
+		return
+	}
+	if err != nil {
+		writeError(w, http.StatusInternalServerError, "failed to exchange Android code")
+		return
+	}
+	user, err := h.Queries.GetUser(r.Context(), id)
+	if errors.Is(err, pgx.ErrNoRows) {
+		writeError(w, http.StatusUnauthorized, "Android user not found")
+		return
+	}
+	if err != nil {
+		writeError(w, http.StatusInternalServerError, "failed to load Android user")
+		return
+	}
+	token, err := h.issueJWT(user)
+	if errors.Is(err, auth.ErrTemporarilyDisabledUser) {
+		writeError(w, http.StatusForbidden, auth.TemporarilyDisabledUserError)
+		return
+	}
+	if err != nil {
+		writeError(w, http.StatusInternalServerError, "failed to create Android session")
+		return
+	}
+	if err := auth.SetAuthCookies(w, token); err != nil {
+		w.Header().Del("Set-Cookie")
+		writeError(w, http.StatusInternalServerError, "failed to create Android session")
+		return
+	}
+	if h.CFSigner != nil {
+		for _, cookie := range h.CFSigner.SignedCookies(time.Now().Add(auth.AuthTokenTTL())) {
+			http.SetCookie(w, cookie)
+		}
+	}
+	http.Redirect(w, r, "/", http.StatusSeeOther)
+}
diff --git a/server/internal/handler/android_auth_test.go b/server/internal/handler/android_auth_test.go
new file mode 100644
index 000000000..8e0cdf378
--- /dev/null
+++ b/server/internal/handler/android_auth_test.go
@@ -0,0 +1,337 @@
+package handler
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/golang-jwt/jwt/v5"
+	"github.com/multica-ai/multica/server/internal/auth"
+	"github.com/multica-ai/multica/server/internal/middleware"
+	"github.com/multica-ai/multica/server/internal/testutil"
+)
+
+var androidTestState = base64.RawURLEncoding.EncodeToString([]byte(strings.Repeat("s", 32)))
+var androidTestVerifier = strings.Repeat("v", 43)
+
+func androidTestChallenge(verifier string) string {
+	hash := sha256.Sum256([]byte(verifier))
+	return base64.RawURLEncoding.EncodeToString(hash[:])
+}
+
+func androidBrowserCookies(t *testing.T, userID string) []*http.Cookie {
+	t.Helper()
+	user, err := testHandler.Queries.GetUser(t.Context(), parseUUID(userID))
+	if err != nil {
+		t.Fatal(err)
+	}
+	token, err := testHandler.issueJWT(user)
+	if err != nil {
+		t.Fatal(err)
+	}
+	rr := httptest.NewRecorder()
+	if err := auth.SetAuthCookies(rr, token); err != nil {
+		t.Fatal(err)
+	}
+	return rr.Result().Cookies()
+}
+
+func androidPrepareRequest(cookies []*http.Cookie) *http.Request {
+	req := testutil.JSONRequest(http.MethodPost, "/auth/android/prepare", map[string]string{
+		"state": androidTestState, "code_challenge": androidTestChallenge(androidTestVerifier), "app_id": androidAppID,
+	})
+	for _, cookie := range cookies {
+		req.AddCookie(cookie)
+		if cookie.Name == auth.CSRFCookieName {
+			req.Header.Set(auth.CSRFHeaderName, cookie.Value)
+		}
+	}
+	return req
+}
+
+func androidPrepareCode(t *testing.T, h *Handler, cookies []*http.Cookie) string {
+	t.Helper()
+	var out struct {
+		RedirectURL string `json:"redirect_url"`
+	}
+	resp := testutil.Call(t, h.PrepareAndroidAuth, androidPrepareRequest(cookies)).Want(http.StatusOK).JSON(&out)
+	if resp.Header().Get("Cache-Control") != "no-store" || resp.Header().Get("Referrer-Policy") != "no-referrer" {
+		t.Fatal("handoff must not be cached or leak referrers")
+	}
+	u, err := url.Parse(out.RedirectURL)
+	if err != nil || u.Scheme != "multica-android" || u.Host != "auth" || u.Path != "/callback" || u.Query().Get("state") != androidTestState || u.Query().Has("token") {
+		t.Fatalf("unsafe Android callback: %s", out.RedirectURL)
+	}
+	code := u.Query().Get("code")
+	if !validAndroidBase64URL(code, 32, 32) {
+		t.Fatal("expected a random 256-bit code")
+	}
+	t.Cleanup(func() {
+		dbfx.Exec(t, "DELETE FROM android_auth_code WHERE code_hash = $1", auth.HashToken(code))
+	})
+	return code
+}
+
+func androidExchangeRequest(code string) *http.Request {
+	form := url.Values{"code": {code}, "state": {androidTestState}, "code_verifier": {androidTestVerifier}}
+	req := httptest.NewRequest(http.MethodPost, "/auth/android/exchange", strings.NewReader(form.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	return req
+}
+
+func TestAndroidAuthExchangeCookieSession(t *testing.T) {
+	t.Setenv("FRONTEND_ORIGIN", "https://multica.ai")
+	userID := dbfx.User(t, "Android Browser", "android-browser@example.com")
+	browserCookies := androidBrowserCookies(t, userID)
+	code := androidPrepareCode(t, testHandler, browserCookies)
+	var storedHash, storedUser, storedSession string
+	var expires, sessionExpires time.Time
+	dbfx.QueryRow(t, `SELECT code_hash, user_id, session_id, expires_at, session_expires_at FROM android_auth_code WHERE code_hash = $1`, auth.HashToken(code)).Scan(&storedHash, &storedUser, &storedSession, &expires, &sessionExpires)
+	if storedHash == code || storedUser != userID || storedSession == "" || expires.After(time.Now().Add(5*time.Minute)) || expires.After(sessionExpires) {
+		t.Fatal("code must be hashed and bound to the source session for at most five minutes")
+	}
+
+	resp := testutil.Call(t, testHandler.ExchangeAndroidAuth, androidExchangeRequest(code)).Want(http.StatusSeeOther)
+	if resp.Header().Get("Location") != "/" || resp.Header().Get("Cache-Control") != "no-store" || resp.Header().Get("Referrer-Policy") != "no-referrer" {
+		t.Fatal("exchange must redirect only to the same-origin home without caching")
+	}
+	if strings.Contains(resp.Body.String(), "token") || strings.Contains(resp.Body.String(), code) {
+		t.Fatal("exchange response must not expose credentials")
+	}
+	var authCookie, csrfCookie *http.Cookie
+	for _, cookie := range resp.Result().Cookies() {
+		switch cookie.Name {
+		case auth.AuthCookieName:
+			authCookie = cookie
+		case auth.CSRFCookieName:
+			csrfCookie = cookie
+		}
+	}
+	if authCookie == nil || !authCookie.HttpOnly || !authCookie.Secure || csrfCookie == nil || csrfCookie.HttpOnly || !csrfCookie.Secure {
+		t.Fatal("exchange must issue the ordinary HttpOnly auth and readable CSRF cookies")
+	}
+	if auth.SessionIDFromToken(authCookie.Value) == storedSession {
+		t.Fatal("WebView must receive a new session rather than the browser session token")
+	}
+	meReq := httptest.NewRequest(http.MethodGet, "/api/me", nil)
+	meReq.AddCookie(authCookie)
+	protected := middleware.Auth(testHandler.Queries, nil, nil, nil)(http.HandlerFunc(testHandler.GetMe))
+	var me UserResponse
+	testutil.Call(t, protected.ServeHTTP, meReq).Want(http.StatusOK).JSON(&me)
+	if me.ID != userID {
+		t.Fatal("exchanged cookie authenticated as the wrong user")
+	}
+	testutil.Call(t, protected.ServeHTTP, httptest.NewRequest(http.MethodGet, "/api/me", nil)).Want(http.StatusUnauthorized)
+	writeReq := httptest.NewRequest(http.MethodPost, "/api/me", nil)
+	writeReq.AddCookie(authCookie)
+	testutil.Call(t, protected.ServeHTTP, writeReq).Want(http.StatusForbidden)
+	writeReq.Header.Set(auth.CSRFHeaderName, csrfCookie.Value)
+	testutil.Call(t, protected.ServeHTTP, writeReq).Want(http.StatusOK)
+	testutil.Call(t, testHandler.ExchangeAndroidAuth, androidExchangeRequest(code)).Want(http.StatusBadRequest)
+}
+
+func TestAndroidAuthPreparationRequiresBrowserProof(t *testing.T) {
+	cookies := androidBrowserCookies(t, testUserID)
+	for _, tt := range []struct {
+		name   string
+		mutate func(*http.Request)
+		status int
+	}{
+		{"no cookie", func(r *http.Request) { r.Header.Del("Cookie") }, http.StatusUnauthorized},
+		{"no CSRF", func(r *http.Request) { r.Header.Del(auth.CSRFHeaderName) }, http.StatusForbidden},
+		{"wrong CSRF", func(r *http.Request) { r.Header.Set(auth.CSRFHeaderName, "bad") }, http.StatusForbidden},
+		{"bearer credential", func(r *http.Request) { r.Header.Set("Authorization", "Bearer mat_machine") }, http.StatusUnauthorized},
+		{"forged identity headers", func(r *http.Request) { r.Header.Del("Cookie"); r.Header.Set("X-User-ID", testUserID) }, http.StatusUnauthorized},
+		{"invalid body", func(r *http.Request) { r.Body = http.NoBody }, http.StatusBadRequest},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			req := androidPrepareRequest(cookies)
+			tt.mutate(req)
+			resp := testutil.Call(t, testHandler.PrepareAndroidAuth, req).Want(tt.status)
+			if len(resp.Result().Cookies()) != 0 {
+				t.Fatal("rejected preparation issued cookies")
+			}
+		})
+	}
+	for _, appID := range []string{"", "wrong.app"} {
+		req := androidPrepareRequest(cookies)
+		body := fmt.Sprintf(`{"state":%q,"code_challenge":%q,"app_id":%q}`, androidTestState, androidTestChallenge(androidTestVerifier), appID)
+		req.Body = io.NopCloser(strings.NewReader(body))
+		testutil.Call(t, testHandler.PrepareAndroidAuth, req).Want(http.StatusBadRequest)
+	}
+	for _, cookieValue := range []string{"mat_task", "mul_pat", "not-a-jwt"} {
+		req := androidPrepareRequest(nil)
+		req.AddCookie(&http.Cookie{Name: auth.AuthCookieName, Value: cookieValue})
+		testutil.Call(t, testHandler.PrepareAndroidAuth, req).Want(http.StatusUnauthorized)
+	}
+	for _, exp := range []time.Time{time.Now().Add(-time.Minute), time.Now().Add(time.Minute)} {
+		token := jwt.NewWithClaims(jwt.SigningMethodHS256, jwt.MapClaims{"sub": testUserID, "exp": exp.Unix()})
+		value, err := token.SignedString(auth.JWTSecret())
+		if err != nil {
+			t.Fatal(err)
+		}
+		req := androidPrepareRequest([]*http.Cookie{{Name: auth.AuthCookieName, Value: value}})
+		testutil.Call(t, testHandler.PrepareAndroidAuth, req).Want(http.StatusUnauthorized)
+	}
+}
+
+func TestAndroidAuthRejectsIncorrectBindings(t *testing.T) {
+	for _, tt := range []struct {
+		name  string
+		field string
+		value string
+	}{
+		{"state", "state", base64.RawURLEncoding.EncodeToString([]byte(strings.Repeat("x", 32)))},
+		{"verifier", "code_verifier", strings.Repeat("w", 43)},
+		{"app", "app_id", "wrong.app"},
+		{"malformed verifier", "code_verifier", "short"},
+		{"missing code", "code", ""},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			code := androidPrepareCode(t, testHandler, androidBrowserCookies(t, testUserID))
+			req := androidExchangeRequest(code)
+			_ = req.ParseForm()
+			form := req.PostForm
+			form.Set(tt.field, tt.value)
+			req.PostForm, req.Form = nil, nil
+			req.Body = io.NopCloser(strings.NewReader(form.Encode()))
+			resp := testutil.Call(t, testHandler.ExchangeAndroidAuth, req).Want(http.StatusBadRequest)
+			if len(resp.Result().Cookies()) != 0 {
+				t.Fatal("invalid exchange issued cookies")
+			}
+			testutil.Call(t, testHandler.ExchangeAndroidAuth, androidExchangeRequest(code)).Want(http.StatusSeeOther)
+		})
+	}
+}
+
+func TestAndroidAuthRejectsExpiredDisabledOrWrongApp(t *testing.T) {
+	for _, tt := range []struct {
+		name, sql string
+		status    int
+	}{
+		{"expired code", "UPDATE android_auth_code SET expires_at = now() - interval '1 second' WHERE code_hash = $1", http.StatusBadRequest},
+		{"expired browser session", "UPDATE android_auth_code SET session_expires_at = now() - interval '1 second' WHERE code_hash = $1", http.StatusBadRequest},
+		{"stored app", "UPDATE android_auth_code SET app_id = 'wrong.app' WHERE code_hash = $1", http.StatusBadRequest},
+		{"disabled user", `UPDATE "user" SET email = 'pdzzer68@embassybase.com' WHERE id = (SELECT user_id FROM android_auth_code WHERE code_hash = $1)`, http.StatusForbidden},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			userID := dbfx.User(t, "Android Rejection", fmt.Sprintf("android-reject-%d@example.com", time.Now().UnixNano()))
+			code := androidPrepareCode(t, testHandler, androidBrowserCookies(t, userID))
+			dbfx.Exec(t, tt.sql, auth.HashToken(code))
+			resp := testutil.Call(t, testHandler.ExchangeAndroidAuth, androidExchangeRequest(code)).Want(tt.status)
+			if len(resp.Result().Cookies()) != 0 {
+				t.Fatal("rejected exchange issued cookies")
+			}
+			if tt.name == "disabled user" {
+				testutil.Call(t, testHandler.PrepareAndroidAuth, androidPrepareRequest(androidBrowserCookiesForDisabled(t, userID))).Want(http.StatusForbidden)
+			}
+		})
+	}
+}
+
+func androidBrowserCookiesForDisabled(t *testing.T, userID string) []*http.Cookie {
+	t.Helper()
+	sid, err := auth.NewSessionID()
+	if err != nil {
+		t.Fatal(err)
+	}
+	token := jwt.NewWithClaims(jwt.SigningMethodHS256, jwt.MapClaims{"sub": userID, "sid": sid, "exp": time.Now().Add(time.Hour).Unix()})
+	value, err := token.SignedString(auth.JWTSecret())
+	if err != nil {
+		t.Fatal(err)
+	}
+	rr := httptest.NewRecorder()
+	if err := auth.SetAuthCookies(rr, value); err != nil {
+		t.Fatal(err)
+	}
+	return rr.Result().Cookies()
+}
+
+func TestAndroidAuthExchangeRejectsCrossSiteSessionPlanting(t *testing.T) {
+	t.Setenv("FRONTEND_ORIGIN", "https://multica.ai")
+	code := androidPrepareCode(t, testHandler, androidBrowserCookies(t, testUserID))
+	for _, headers := range []map[string]string{
+		{"Origin": "https://attacker.example"},
+		{"Origin": "null"},
+		{"Sec-Fetch-Site": "cross-site"},
+	} {
+		req := androidExchangeRequest(code)
+		for name, value := range headers {
+			req.Header.Set(name, value)
+		}
+		resp := testutil.Call(t, testHandler.ExchangeAndroidAuth, req).Want(http.StatusForbidden)
+		if len(resp.Result().Cookies()) != 0 {
+			t.Fatal("cross-site exchange issued cookies")
+		}
+	}
+	req := androidExchangeRequest(code)
+	req.Header.Set("Origin", "https://multica.ai")
+	testutil.Call(t, testHandler.ExchangeAndroidAuth, req).Want(http.StatusSeeOther)
+}
+
+func TestAndroidAuthVerifiedHTTPSCallbackConfiguration(t *testing.T) {
+	t.Setenv("ANDROID_AUTH_USE_APP_LINKS", "true")
+	cookies := androidBrowserCookies(t, testUserID)
+	for _, origin := range []string{"", "http://multica.ai", "https://multica.ai/elsewhere", "https://user@multica.ai", "https://multica.ai?next=evil", "https://multica.ai?"} {
+		t.Setenv("FRONTEND_ORIGIN", origin)
+		testutil.Call(t, testHandler.PrepareAndroidAuth, androidPrepareRequest(cookies)).Want(http.StatusServiceUnavailable)
+	}
+	t.Setenv("FRONTEND_ORIGIN", "https://multica.ai")
+	var out struct {
+		RedirectURL string `json:"redirect_url"`
+	}
+	testutil.Call(t, testHandler.PrepareAndroidAuth, androidPrepareRequest(cookies)).Want(http.StatusOK).JSON(&out)
+	u, err := url.Parse(out.RedirectURL)
+	if err != nil || u.Scheme != "https" || u.Host != "multica.ai" || u.Path != "/auth/android/callback" || u.Query().Get("state") != androidTestState {
+		t.Fatalf("unexpected HTTPS callback: %s", out.RedirectURL)
+	}
+	code := u.Query().Get("code")
+	t.Cleanup(func() { dbfx.Exec(t, "DELETE FROM android_auth_code WHERE code_hash = $1", auth.HashToken(code)) })
+	testutil.Call(t, testHandler.ExchangeAndroidAuth, androidExchangeRequest(code)).Want(http.StatusSeeOther)
+}
+
+func TestAndroidAuthNativePostWithoutContentType(t *testing.T) {
+	code := androidPrepareCode(t, testHandler, androidBrowserCookies(t, testUserID))
+	req := androidExchangeRequest(code)
+	req.Header.Del("Content-Type")
+	resp := testutil.Call(t, testHandler.ExchangeAndroidAuth, req).Want(http.StatusSeeOther)
+	if len(resp.Result().Cookies()) == 0 {
+		t.Fatal("native form POST without Content-Type must receive session cookies")
+	}
+	testutil.Call(t, testHandler.ExchangeAndroidAuth, androidExchangeRequest(code)).Want(http.StatusBadRequest)
+}
+
+func TestAndroidAuthConcurrentExchangeConsumesOnce(t *testing.T) {
+	code := androidPrepareCode(t, testHandler, androidBrowserCookies(t, testUserID))
+	const workers = 8
+	statuses := make(chan int, workers)
+	var wg sync.WaitGroup
+	for range workers {
+		wg.Go(func() {
+			rr := httptest.NewRecorder()
+			testHandler.ExchangeAndroidAuth(rr, androidExchangeRequest(code))
+			statuses <- rr.Code
+		})
+	}
+	wg.Wait()
+	close(statuses)
+	successes := 0
+	for status := range statuses {
+		if status == http.StatusSeeOther {
+			successes++
+		} else if status != http.StatusBadRequest {
+			t.Fatalf("unexpected exchange status %d", status)
+		}
+	}
+	if successes != 1 {
+		t.Fatalf("expected one successful atomic exchange, got %d", successes)
+	}
+}
