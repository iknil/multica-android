+package main
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestAndroidAuthRoutes(t *testing.T) {
+	for _, tc := range []struct {
+		path, contentType string
+		status            int
+	}{
+		{"/auth/android/prepare", "application/json", http.StatusUnauthorized},
+		{"/auth/android/exchange", "application/json", http.StatusUnsupportedMediaType},
+		{"/auth/android/exchange", "application/x-www-form-urlencoded", http.StatusBadRequest},
+		{"/auth/android/exchange", "", http.StatusBadRequest},
+	} {
+		t.Run(tc.path+tc.contentType, func(t *testing.T) {
+			req := httptest.NewRequest(http.MethodPost, tc.path, strings.NewReader(""))
+			req.Header.Set("Content-Type", tc.contentType)
+			rec := httptest.NewRecorder()
+			testServer.Config.Handler.ServeHTTP(rec, req)
+			if rec.Code != tc.status {
+				t.Fatalf("status=%d, want=%d: %s", rec.Code, tc.status, rec.Body.String())
+			}
+			if rec.Header().Get("Cache-Control") != "no-store" || rec.Header().Get("Referrer-Policy") != "no-referrer" {
+				t.Fatal("Android routes must retain credential-protection headers on failures")
+			}
+		})
+	}
+}
