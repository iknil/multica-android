@@ -0,0 +1,328 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { setSchemaLogger } from "@multica/core/api";
+import { noopLogger } from "@multica/core/logger";
+
+afterEach(() => setSchemaLogger(noopLogger));
+
+const { mockGetBaseUrl } = vi.hoisted(() => ({
+  mockGetBaseUrl: vi.fn(() => "https://api.example.test"),
+}));
+
+vi.mock("@multica/core/api", async () => {
+  const actual = await vi.importActual<typeof import("@multica/core/api")>(
+    "@multica/core/api",
+  );
+  return {
+    ...actual,
+    api: { getBaseUrl: mockGetBaseUrl },
+  };
+});
+
+import {
+  ANDROID_APP_ID,
+  androidCallbackUrlFromSearchParams,
+  androidOAuthStateParts,
+  loginAndroidWithGoogle,
+  isSafeAndroidRedirect,
+  prepareAndroidHandoff,
+  readAndroidLoginRequest,
+  readAndroidOAuthRequest,
+  verifyAndroidEmailCode,
+} from "./android-auth";
+
+const STATE = "A".repeat(43);
+const CHALLENGE = `${"B".repeat(42)}A`;
+const REDIRECT_URL = `multica-android://auth/callback?code=one-time-code&state=${STATE}`;
+
+function jsonResponse(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { "Content-Type": "application/json" },
+  });
+}
+
+function clearCookies() {
+  for (const cookie of document.cookie.split(";")) {
+    const name = cookie.split("=")[0]?.trim();
+    if (name) document.cookie = `${name}=; path=/; max-age=0`;
+  }
+}
+
+function requestInit(fetchMock: ReturnType<typeof vi.fn>) {
+  const call = fetchMock.mock.calls[0];
+  if (!call) throw new Error("Expected fetch to be called");
+  return call[1] as RequestInit;
+}
+
+describe("Android auth request validation", () => {
+  it("accepts canonical state values from 16 through 96 bytes and a 32-byte challenge", () => {
+    const sixteenByteState = "A".repeat(22);
+    const ninetySixByteState = "A".repeat(128);
+
+    for (const state of [sixteenByteState, STATE, ninetySixByteState]) {
+      const result = readAndroidLoginRequest(
+        new URLSearchParams({
+          platform: "android",
+          android_state: state,
+          android_challenge: CHALLENGE,
+        }),
+      );
+      expect(result).toEqual({
+        kind: "valid",
+        request: { state, codeChallenge: CHALLENGE },
+      });
+    }
+  });
+
+  it.each([
+    ["short state", "A".repeat(21), CHALLENGE],
+    ["non-canonical state", "A".repeat(21) + "B", CHALLENGE],
+    ["padded state", `${STATE}=`, CHALLENGE],
+    ["short challenge", STATE, "A".repeat(42)],
+    ["non-canonical challenge", STATE, "B".repeat(43)],
+  ])("rejects a %s", (_case, state, challenge) => {
+    expect(
+      readAndroidLoginRequest(
+        new URLSearchParams({
+          platform: "android",
+          android_state: state,
+          android_challenge: challenge,
+        }),
+      ),
+    ).toEqual({ kind: "invalid" });
+  });
+
+  it("allows only the custom scheme or a strict same-origin HTTPS app link", () => {
+    expect(isSafeAndroidRedirect(REDIRECT_URL, "http://localhost:3000")).toBe(
+      true,
+    );
+    const appLink =
+      `https://app.example.test/auth/android/callback?code=one-time-code&state=${STATE}`;
+    expect(isSafeAndroidRedirect(appLink, "https://app.example.test")).toBe(
+      true,
+    );
+    expect(isSafeAndroidRedirect(appLink, "http://app.example.test")).toBe(
+      false,
+    );
+    expect(isSafeAndroidRedirect(appLink, "https://other.example.test")).toBe(
+      false,
+    );
+    expect(
+      isSafeAndroidRedirect(
+        `${appLink}&token=must-not-pass`,
+        "https://app.example.test",
+      ),
+    ).toBe(false);
+    expect(
+      isSafeAndroidRedirect(
+        `https://app.example.test/auth/android/exchange?code=x&state=${STATE}`,
+        "https://app.example.test",
+      ),
+    ).toBe(false);
+  });
+
+  it.each([
+    `multica-android://user@auth/callback?code=x&state=${STATE}`,
+    `multica-android://auth:8080/callback?code=x&state=${STATE}`,
+    `https://user:password@app.example.test/auth/android/callback?code=x&state=${STATE}`,
+  ])("rejects credentials or a custom-scheme port in a redirect", (value) => {
+    expect(isSafeAndroidRedirect(value, "https://app.example.test")).toBe(false);
+  });
+
+  it("round-trips Android fields through Google OAuth state", () => {
+    const parts = androidOAuthStateParts({
+      state: STATE,
+      codeChallenge: CHALLENGE,
+    });
+    expect(readAndroidOAuthRequest(parts)).toEqual({
+      kind: "valid",
+      request: { state: STATE, codeChallenge: CHALLENGE },
+    });
+  });
+
+  it("rejects duplicate or malformed Android OAuth state fields", () => {
+    expect(
+      readAndroidOAuthRequest([
+        "platform:android",
+        `android_state:${STATE}`,
+        `android_state:${STATE}`,
+        `android_challenge:${CHALLENGE}`,
+      ]),
+    ).toEqual({ kind: "invalid" });
+    expect(
+      readAndroidOAuthRequest([
+        "platform:android",
+        "android_state:%broken",
+        `android_challenge:${CHALLENGE}`,
+      ]),
+    ).toEqual({ kind: "invalid" });
+  });
+});
+
+describe("Android cookie-only requests", () => {
+  beforeEach(() => {
+    vi.restoreAllMocks();
+    clearCookies();
+    localStorage.clear();
+  });
+
+  it("verifies an email code with cookie_only and no bearer token", async () => {
+    const fetchMock = vi
+      .spyOn(globalThis, "fetch")
+      .mockResolvedValue(jsonResponse({ user: { id: "user-1" } }));
+
+    await expect(
+      verifyAndroidEmailCode("person@example.com", "123456"),
+    ).resolves.toMatchObject({ id: "user-1" });
+
+    expect(fetchMock).toHaveBeenCalledWith(
+      "https://api.example.test/auth/verify-code",
+      expect.objectContaining({
+        method: "POST",
+        credentials: "include",
+      }),
+    );
+    const init = requestInit(fetchMock);
+    expect(JSON.parse(String(init.body))).toEqual({
+      email: "person@example.com",
+      code: "123456",
+      cookie_only: true,
+    });
+    expect(new Headers(init.headers).has("Authorization")).toBe(false);
+    expect(localStorage.length).toBe(0);
+  });
+
+  it("exchanges a Google code with cookie_only and no bearer token", async () => {
+    const fetchMock = vi
+      .spyOn(globalThis, "fetch")
+      .mockResolvedValue(jsonResponse({ user: { id: "user-1" } }));
+
+    await loginAndroidWithGoogle(
+      "google-code",
+      "https://app.example.test/auth/callback",
+    );
+
+    expect(fetchMock).toHaveBeenCalledWith(
+      "https://api.example.test/auth/google",
+      expect.any(Object),
+    );
+    const init = requestInit(fetchMock);
+    expect(JSON.parse(String(init.body))).toEqual({
+      code: "google-code",
+      redirect_uri: "https://app.example.test/auth/callback",
+      cookie_only: true,
+    });
+    expect(new Headers(init.headers).has("Authorization")).toBe(false);
+    expect(localStorage.length).toBe(0);
+  });
+
+  it("prepares the handoff with cookies, the session CSRF value, and no Authorization", async () => {
+    document.cookie = "multica_csrf=token-bound; path=/";
+    document.cookie = "multica_csrf_session=session-bound; path=/";
+    const fetchMock = vi
+      .spyOn(globalThis, "fetch")
+      .mockResolvedValue(jsonResponse({ redirect_url: REDIRECT_URL }));
+
+    await expect(
+      prepareAndroidHandoff({ state: STATE, codeChallenge: CHALLENGE }),
+    ).resolves.toBe(REDIRECT_URL);
+
+    expect(fetchMock).toHaveBeenCalledWith(
+      "https://api.example.test/auth/android/prepare",
+      expect.objectContaining({
+        method: "POST",
+        credentials: "include",
+      }),
+    );
+    const init = requestInit(fetchMock);
+    const headers = new Headers(init.headers);
+    expect(headers.get("X-CSRF-Token")).toBe("session-bound");
+    expect(headers.has("Authorization")).toBe(false);
+    expect(JSON.parse(String(init.body))).toEqual({
+      state: STATE,
+      code_challenge: CHALLENGE,
+      app_id: ANDROID_APP_ID,
+    });
+    expect(localStorage.length).toBe(0);
+  });
+
+  it("fails before fetching when the session has no readable CSRF cookie", async () => {
+    const fetchMock = vi.spyOn(globalThis, "fetch");
+
+    await expect(
+      prepareAndroidHandoff({ state: STATE, codeChallenge: CHALLENGE }),
+    ).rejects.toThrow("Missing CSRF cookie");
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    ["wrong scheme", `https://evil.example/callback?code=x&state=${STATE}`],
+    [
+      "token parameter",
+      `multica-android://auth/callback?code=x&state=${STATE}&token=jwt`,
+    ],
+    [
+      "mismatched state",
+      `multica-android://auth/callback?code=x&state=${"C".repeat(42)}A`,
+    ],
+  ])("rejects a %s in the prepare response", async (_case, redirectUrl) => {
+    document.cookie = "multica_csrf=csrf; path=/";
+    vi.spyOn(globalThis, "fetch").mockResolvedValue(
+      jsonResponse({ redirect_url: redirectUrl }),
+    );
+
+    await expect(
+      prepareAndroidHandoff({ state: STATE, codeChallenge: CHALLENGE }),
+    ).rejects.toThrow();
+  });
+
+  it("does not log a code-bearing response when redirect validation fails", async () => {
+    const warn = vi.fn();
+    setSchemaLogger({ ...noopLogger, warn });
+    document.cookie = "multica_csrf=csrf; path=/";
+    const secret = "one-use-sensitive-code";
+    vi.spyOn(globalThis, "fetch").mockResolvedValue(jsonResponse({
+      redirect_url: `https://attacker.example/?code=${secret}&state=${STATE}`,
+    }));
+    await expect(prepareAndroidHandoff({ state: STATE, codeChallenge: CHALLENGE })).rejects.toThrow();
+    expect(warn).toHaveBeenCalledOnce();
+    expect(JSON.stringify(warn.mock.calls)).not.toContain(secret);
+  });
+
+  it("preserves actionable error codes without retaining credential-bearing error payloads", async () => {
+    vi.spyOn(globalThis, "fetch").mockResolvedValue(jsonResponse({
+      error: "account disabled", code: "account_disabled", token: "must-not-retain", code_verifier: "must-not-retain",
+    }, 403));
+    const error = await loginAndroidWithGoogle("google-code", "https://app.example.test/auth/callback").catch((error: unknown) => error);
+    expect(error).toMatchObject({ status: 403, body: { code: "account_disabled" } });
+    expect(JSON.stringify(error)).not.toContain("must-not-retain");
+  });
+
+  it("surfaces backend errors without accepting a malformed success body", async () => {
+    vi.spyOn(globalThis, "fetch").mockResolvedValue(
+      jsonResponse({ error: "code expired" }, 400),
+    );
+
+    await expect(
+      verifyAndroidEmailCode("person@example.com", "000000"),
+    ).rejects.toMatchObject({ status: 400, message: "code expired" });
+  });
+});
+
+describe("HTTPS Android callback safety", () => {
+  it("builds only the fixed custom-scheme callback", () => {
+    expect(
+      androidCallbackUrlFromSearchParams(
+        new URLSearchParams({ code: "one-time-code", state: STATE }),
+      ),
+    ).toBe(REDIRECT_URL);
+  });
+
+  it.each([
+    new URLSearchParams({ state: STATE }),
+    new URLSearchParams({ code: "one-time-code", state: "not-base64url" }),
+    new URLSearchParams({ code: "one-time-code", state: STATE, token: "jwt" }),
+  ])("rejects missing, malformed, or extra callback data", (params) => {
+    expect(androidCallbackUrlFromSearchParams(params)).toBeNull();
+  });
+});
diff --git a/apps/web/features/auth/android-auth.ts b/apps/web/features/auth/android-auth.ts
new file mode 100644
index 000000000..8a7a40edf
--- /dev/null
+++ b/apps/web/features/auth/android-auth.ts
@@ -0,0 +1,322 @@
+import { api, ApiError, parseWithFallback } from "@multica/core/api";
+import { UserSchema } from "@multica/core/api/schemas";
+import type { User } from "@multica/core/types";
+import { z } from "zod";
+
+export const ANDROID_APP_ID = "ai.multica.android";
+
+const BASE64URL_ALPHABET =
+  "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+const BASE64URL_PATTERN = /^[A-Za-z0-9_-]+$/;
+const MAX_AUTH_CODE_LENGTH = 2048;
+
+function isCanonicalBase64Url(
+  value: string,
+  minDecodedBytes: number,
+  maxDecodedBytes: number,
+): boolean {
+  if (!BASE64URL_PATTERN.test(value)) return false;
+
+  const remainder = value.length % 4;
+  if (remainder === 1) return false;
+
+  const decodedBytes = Math.floor((value.length * 6) / 8);
+  if (decodedBytes < minDecodedBytes || decodedBytes > maxDecodedBytes) {
+    return false;
+  }
+
+  const lastValue = BASE64URL_ALPHABET.indexOf(value.at(-1) ?? "");
+  if (lastValue < 0) return false;
+  if (remainder === 2 && lastValue % 16 !== 0) return false;
+  if (remainder === 3 && lastValue % 4 !== 0) return false;
+  return true;
+}
+
+function isAndroidState(value: string): boolean {
+  return isCanonicalBase64Url(value, 16, 96);
+}
+
+function isAndroidChallenge(value: string): boolean {
+  return isCanonicalBase64Url(value, 32, 32);
+}
+
+const AndroidLoginRequestSchema = z.object({
+  state: z.string().refine(isAndroidState),
+  codeChallenge: z.string().refine(isAndroidChallenge),
+});
+
+const CookieOnlyLoginResponseSchema = z.object({
+  user: UserSchema,
+});
+
+const ErrorResponseSchema = z.object({
+  error: z.string().optional(),
+  code: z.enum([
+    "account_disabled",
+    "signup_prohibited",
+    "email_not_allowed",
+    "google_account_no_email",
+    "oauth_code_invalid",
+  ]).optional().catch(undefined),
+});
+
+export function isSafeAndroidRedirect(
+  value: string,
+  frontendOrigin: string,
+): boolean {
+  try {
+    const url = new URL(value);
+    const origin = new URL(frontendOrigin);
+    const keys = [...url.searchParams.keys()];
+    const code = url.searchParams.get("code") ?? "";
+    const hasSafeCallbackParams =
+      url.hash === "" &&
+      url.username === "" &&
+      url.password === "" &&
+      url.searchParams.getAll("code").length === 1 &&
+      code.length > 0 &&
+      code.length <= MAX_AUTH_CODE_LENGTH &&
+      url.searchParams.getAll("state").length === 1 &&
+      isAndroidState(url.searchParams.get("state") ?? "") &&
+      keys.every((key) => key === "code" || key === "state");
+    const isCustomScheme =
+      url.protocol === "multica-android:" &&
+      url.hostname === "auth" &&
+      url.port === "" &&
+      url.pathname === "/callback";
+    const isSameOriginAppLink =
+      origin.protocol === "https:" &&
+      url.protocol === "https:" &&
+      url.origin === origin.origin &&
+      url.pathname === "/auth/android/callback";
+    return hasSafeCallbackParams && (isCustomScheme || isSameOriginAppLink);
+  } catch {
+    return false;
+  }
+}
+
+function androidPrepareResponseSchema(frontendOrigin: string) {
+  return z.object({
+    redirect_url: z
+      .string()
+      .refine((value) => isSafeAndroidRedirect(value, frontendOrigin)),
+  });
+}
+
+const AndroidCallbackQuerySchema = z.object({
+  code: z.string().min(1).max(MAX_AUTH_CODE_LENGTH),
+  state: z.string().refine(isAndroidState),
+});
+
+export interface AndroidLoginRequest {
+  state: string;
+  codeChallenge: string;
+}
+
+export type AndroidLoginRequestResult =
+  | { kind: "none" }
+  | { kind: "invalid" }
+  | { kind: "valid"; request: AndroidLoginRequest };
+
+interface SearchParamsReader {
+  get(name: string): string | null;
+  getAll(name: string): string[];
+  keys(): IterableIterator<string>;
+}
+
+export function readAndroidLoginRequest(
+  searchParams: Pick<SearchParamsReader, "get" | "getAll">,
+): AndroidLoginRequestResult {
+  if (searchParams.get("platform") !== "android") return { kind: "none" };
+  if (
+    searchParams.getAll("android_state").length !== 1 ||
+    searchParams.getAll("android_challenge").length !== 1
+  ) {
+    return { kind: "invalid" };
+  }
+
+  const parsed = AndroidLoginRequestSchema.safeParse({
+    state: searchParams.get("android_state"),
+    codeChallenge: searchParams.get("android_challenge"),
+  });
+  return parsed.success
+    ? { kind: "valid", request: parsed.data }
+    : { kind: "invalid" };
+}
+
+export function androidOAuthStateParts(request: AndroidLoginRequest): string[] {
+  return [
+    "platform:android",
+    `android_state:${encodeURIComponent(request.state)}`,
+    `android_challenge:${encodeURIComponent(request.codeChallenge)}`,
+  ];
+}
+
+export function readAndroidOAuthRequest(
+  stateParts: string[],
+): AndroidLoginRequestResult {
+  if (!stateParts.includes("platform:android")) return { kind: "none" };
+
+  const stateValues = stateParts.filter((part) =>
+    part.startsWith("android_state:"),
+  );
+  const challengeValues = stateParts.filter((part) =>
+    part.startsWith("android_challenge:"),
+  );
+  if (stateValues.length !== 1 || challengeValues.length !== 1) {
+    return { kind: "invalid" };
+  }
+
+  try {
+    const parsed = AndroidLoginRequestSchema.safeParse({
+      state: decodeURIComponent(
+        stateValues[0]!.slice("android_state:".length),
+      ),
+      codeChallenge: decodeURIComponent(
+        challengeValues[0]!.slice("android_challenge:".length),
+      ),
+    });
+    return parsed.success
+      ? { kind: "valid", request: parsed.data }
+      : { kind: "invalid" };
+  } catch {
+    return { kind: "invalid" };
+  }
+}
+
+function apiUrl(path: string): string {
+  return `${api.getBaseUrl()}${path}`;
+}
+
+async function readJson(response: Response): Promise<unknown> {
+  try {
+    return await response.json();
+  } catch {
+    return undefined;
+  }
+}
+
+async function assertOk(response: Response, raw: unknown): Promise<void> {
+  if (response.ok) return;
+  const parsed = parseWithFallback<{ error?: string; code?: string }>(
+    raw,
+    ErrorResponseSchema,
+    {},
+    { endpoint: `${response.status} authentication error`, sensitive: true },
+  );
+  throw new ApiError(
+    parsed.error || `API error: ${response.status} ${response.statusText}`,
+    response.status,
+    response.statusText,
+    parsed.code ? { code: parsed.code } : undefined,
+  );
+}
+
+async function cookieOnlyLogin(
+  path: "/auth/verify-code" | "/auth/google",
+  body: Record<string, unknown>,
+): Promise<User> {
+  const response = await fetch(apiUrl(path), {
+    method: "POST",
+    credentials: "include",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ ...body, cookie_only: true }),
+  });
+  const raw = await readJson(response);
+  await assertOk(response, raw);
+  const parsed = parseWithFallback<{ user: User } | null>(
+    raw,
+    CookieOnlyLoginResponseSchema,
+    null,
+    { endpoint: `POST ${path} (cookie_only)`, sensitive: true },
+  );
+  if (!parsed) throw new Error("Malformed cookie-only login response");
+  return parsed.user;
+}
+
+export function verifyAndroidEmailCode(
+  email: string,
+  code: string,
+): Promise<User> {
+  return cookieOnlyLogin("/auth/verify-code", { email, code });
+}
+
+export function loginAndroidWithGoogle(
+  code: string,
+  redirectUri: string,
+): Promise<User> {
+  return cookieOnlyLogin("/auth/google", {
+    code,
+    redirect_uri: redirectUri,
+  });
+}
+
+function readCookie(name: string): string | null {
+  const prefix = `${name}=`;
+  const match = document.cookie
+    .split(";")
+    .map((part) => part.trim())
+    .find((part) => part.startsWith(prefix));
+  return match ? match.slice(prefix.length) || null : null;
+}
+
+function readCsrfCookie(): string | null {
+  return readCookie("multica_csrf_session") ?? readCookie("multica_csrf");
+}
+
+export async function prepareAndroidHandoff(
+  request: AndroidLoginRequest,
+): Promise<string> {
+  const csrf = readCsrfCookie();
+  if (!csrf) throw new Error("Missing CSRF cookie");
+
+  const response = await fetch(apiUrl("/auth/android/prepare"), {
+    method: "POST",
+    credentials: "include",
+    headers: {
+      "Content-Type": "application/json",
+      "X-CSRF-Token": csrf,
+    },
+    body: JSON.stringify({
+      state: request.state,
+      code_challenge: request.codeChallenge,
+      app_id: ANDROID_APP_ID,
+    }),
+  });
+  const raw = await readJson(response);
+  await assertOk(response, raw);
+  const parsed = parseWithFallback<{ redirect_url: string } | null>(
+    raw,
+    androidPrepareResponseSchema(window.location.origin),
+    null,
+    { endpoint: "POST /auth/android/prepare", sensitive: true },
+  );
+  if (!parsed) throw new Error("Malformed Android handoff response");
+
+  const redirect = new URL(parsed.redirect_url);
+  if (redirect.searchParams.get("state") !== request.state) {
+    throw new Error("Android handoff state mismatch");
+  }
+  return parsed.redirect_url;
+}
+
+export function androidCallbackUrlFromSearchParams(
+  searchParams: SearchParamsReader,
+): string | null {
+  const keys = [...searchParams.keys()];
+  if (
+    searchParams.getAll("code").length !== 1 ||
+    searchParams.getAll("state").length !== 1 ||
+    !keys.every((key) => key === "code" || key === "state")
+  ) {
+    return null;
+  }
+
+  const parsed = AndroidCallbackQuerySchema.safeParse({
+    code: searchParams.get("code"),
+    state: searchParams.get("state"),
+  });
+  if (!parsed.success) return null;
+  const query = new URLSearchParams(parsed.data);
+  return `multica-android://auth/callback?${query}`;
+}
